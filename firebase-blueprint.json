{
  "entities": {
    "Patient": {
      "title": "Patient",
      "description": "Patient profile information",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email"]
    },
    "Appointment": {
      "title": "Appointment",
      "description": "Information about a scheduled clinic visit",
      "type": "object",
      "properties": {
        "patientId": { "type": "string" },
        "patientName": { "type": "string" },
        "doctorName": { "type": "string" },
        "doctorSpecialty": { "type": "string" },
        "service": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "cancelled", "completed"] },
        "notes": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["patientId", "doctorName", "date", "time", "status"]
    },
    "Staff": {
      "title": "Staff",
      "description": "Clinic staff and admin information",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["staff", "admin"] },
        "createdAt": { "type": "number" }
      },
      "required": ["name", "email", "role"]
    }
  },
  "firestore": {
    "/patients/{patientId}": {
      "schema": "Patient",
      "description": "User profile data for patients"
    },
    "/staff/{staffId}": {
      "schema": "Staff",
      "description": "User profile data for staff and admins"
    },
    "/appointments/{appointmentId}": {
      "schema": "Appointment",
      "description": "Collection of all appointments"
    }
  }
}
